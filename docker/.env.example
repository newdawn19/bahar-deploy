# 复制为 .env 后按实际填写： cp .env.example .env

# 演示站根域名。Nginx 按四个子域名分发（后端无 context-path，故不能用路径前缀）：
#   shop.<DOMAIN>    零售
#   car.<DOMAIN>     汽车美容
#   food.<DOMAIN>    餐饮
#   health.<DOMAIN>  康养美业
# DNS 需给这四个名称各加一条 A 记录指向服务器 IP（或用 *.DOMAIN 通配解析）。
DOMAIN=demo.example.com

# MySQL root 密码。四套后端与 MySQL 容器共用此值。
# 生产请务必改成强密码，不要沿用开发环境口令。
DB_PASSWORD=change-me-please
