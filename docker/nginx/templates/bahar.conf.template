# 由 nginx 官方镜像自动渲染（templates/*.template -> /etc/nginx/conf.d/*.conf）
# 只替换 ${DOMAIN}；$host / $remote_addr 等是 nginx 自身变量，不能被 envsubst 吃掉，
# 故 docker-compose.yml 里设置了 NGINX_ENVSUBST_FILTER。

upstream bahar_shop   { server shop:8080; }
upstream bahar_car    { server car:8080; }
upstream bahar_food   { server food:8080; }
upstream bahar_health { server health:8080; }

# 公共代理参数：后端无 context-path，整站透传即可
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# ---------- 零售 ----------
server {
    listen 80;
    server_name shop.${DOMAIN};
    client_max_body_size 20m;

    location / {
        proxy_pass http://bahar_shop;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
    }
}

